package ui

templ themeHead(title string) {
	<title>{ title }</title>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet"/>
	<link rel="stylesheet" href="/assets/app.css"/>
}

// Firefly icon — small glowing dot. Color inherits from text-* on parent.
templ firefly() {
	<svg class="w-full h-full" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<circle cx="20" cy="20" r="5" fill="currentColor"></circle>
		<circle cx="20" cy="20" r="11" fill="currentColor" opacity="0.25"></circle>
	</svg>
}

// Ambient firefly layer — drop into <body> once.
templ fireflies() {
	<div class="fireflies" aria-hidden="true">
		<span></span><span></span><span></span><span></span><span></span><span></span>
	</div>
}

templ stars() {
	<div class="stars" aria-hidden="true">
		<span></span><span></span><span></span>
		<span></span><span></span><span></span>
	</div>
}

// ──── Spring assets — kept for re-swap ────
templ sakuraFlower() {
	<svg class="w-full h-full" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<g fill="currentColor">
			<path d="M20 4 C23 10, 23 16, 20 20 C17 16, 17 10, 20 4 Z"></path>
			<path d="M20 4 C23 10, 23 16, 20 20 C17 16, 17 10, 20 4 Z" transform="rotate(72 20 20)"></path>
			<path d="M20 4 C23 10, 23 16, 20 20 C17 16, 17 10, 20 4 Z" transform="rotate(144 20 20)"></path>
			<path d="M20 4 C23 10, 23 16, 20 20 C17 16, 17 10, 20 4 Z" transform="rotate(216 20 20)"></path>
			<path d="M20 4 C23 10, 23 16, 20 20 C17 16, 17 10, 20 4 Z" transform="rotate(288 20 20)"></path>
		</g>
		<circle cx="20" cy="20" r="2.2" fill="#fce4ec"></circle>
	</svg>
}

templ sakuraPetals() {
	<div class="sakura-petals" aria-hidden="true">
		<span></span><span></span><span></span><span></span><span></span>
	</div>
}
